# Supabase Configuration
# Get these values from your Supabase project settings (Settings → API)

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Redirect URL for auth callbacks (used in development)
# In production, this will use the deployed domain automatically
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional: Service role key (for admin operations - keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
